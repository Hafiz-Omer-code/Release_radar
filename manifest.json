{
  "manifest_version": 3,
  "name": "Release Radar — Countdown & Episode Tracker",
  "version": "1.0.0",
  "description": "Track anime episodes, YouTube premieres/live streams, and any scheduled release with live countdowns in your toolbar.",

  "browser_specific_settings": {
    "gecko": {
      "id": "release-radar@example-extension.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Release Radar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "src/background/background.js",
    "scripts": [
      "src/lib/browser-polyfill-shim.js",
      "src/lib/time.js",
      "src/lib/id.js",
      "src/lib/storage.js",
      "src/extractors/index.js",
      "src/extractors/utils.js",
      "src/extractors/youtube.js",
      "src/extractors/genericSpa.js",
      "src/extractors/genericText.js",
      "src/background/background.js"
    ]
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}

